{
  "name": "@intentset/conformance-suite",
  "version": "0.5.0",
  "description": "The conformance cases, the export consumer fixtures and the schemas as data, for implementations that are not this one. No dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intentset/intentset.git",
    "directory": "packages/conformance-suite"
  },
  "homepage": "https://intentset.org/",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "intentset",
    "conformance",
    "test-suite"
  ],
  "files": [
    "dist",
    "src",
    "cases",
    "schemas",
    "examples",
    "consumer"
  ],
  "exports": {
    ".": {
      "intentset-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cases/*.json": "./cases/*.json",
    "./schemas/*.json": "./schemas/*.json",
    "./consumer/*": "./consumer/*"
  },
  "scripts": {
    "prepack": "node --conditions=intentset-source stage.ts"
  }
}
