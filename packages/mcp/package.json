{
  "name": "@intentset/mcp",
  "version": "0.6.0",
  "description": "Read-only MCP server over an Intentset export, with the publication projection for customer context.",
  "keywords": [
    "intentset",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "traceability"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intentset/intentset.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://intentset.org/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "intentset-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@intentset/core": "^0.6.0",
    "@intentset/publisher": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.32.0"
  }
}
