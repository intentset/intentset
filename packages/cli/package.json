{
  "name": "@intentset/cli",
  "version": "0.6.0",
  "description": "The intentset command: validate, graph, architecture check, evidence, impact, review, publish, serve, context, mcp.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intentset/intentset.git",
    "directory": "packages/cli"
  },
  "homepage": "https://intentset.org/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
