    }
  },
  "bin": {
    "intentset": "./dist/intentset.js"
  },
  "dependencies": {
    "@intentset/core": "^0.6.0",
    "@intentset/markset-adapter": "^0.6.0",
    "@intentset/architecture": "^0.6.0",
    "@intentset/verification": "^0.6.0",
    "@intentset/publisher": "^0.6.0",
    "@intentset/atlas": "^0.6.0",
    "@intentset/mcp": "^0.6.0",
    "@intentset/conformance-suite": "^0.6.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  }
}
