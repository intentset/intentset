{
  "name": "intentset",
  "private": true,
  "type": "module",
  "version": "0.6.1",
  "description": "Intentset: product intent, behavior, implementation, verification and knowledge, connected in readable files. Reference implementation of the v0.1 specifications.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "intentset": "node --conditions=intentset-source packages/cli/src/intentset.ts",
    "test": "node --conditions=intentset-source --test packages/*/test/*.test.ts site/test/*.test.ts test/*.test.ts && pnpm run test:development",
    "test:development": "node --conditions=intentset-source --conditions=development --test packages/*/test/*.test.ts",
    "conformance": "node --conditions=intentset-source packages/conformance/src/cli.ts",
    "conformance:development": "node --conditions=intentset-source --conditions=development packages/conformance/src/cli.ts",
    "fixtures:consumer": "node --conditions=intentset-source packages/conformance/src/consumer-write.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "rm -rf packages/*/dist && node --conditions=intentset-source packages/conformance-suite/stage.ts && tsc -p packages/core/tsconfig.build.json && tsc -p packages/markset-adapter/tsconfig.build.json && tsc -p packages/architecture/tsconfig.build.json && tsc -p packages/verification/tsconfig.build.json && tsc -p packages/publisher/tsconfig.build.json && tsc -p packages/help/tsconfig.build.json && tsc -p packages/atlas/tsconfig.build.json && tsc -p packages/mcp/tsconfig.build.json && tsc -p packages/conformance-suite/tsconfig.build.json && tsc -p packages/cli/tsconfig.build.json",
    "site": "node --conditions=intentset-source site/build.ts",
    "site:watch": "node --conditions=intentset-source site/serve.ts",
    "social-card": "node --conditions=intentset-source site/social-card.ts",
    "e2e": "playwright test",
    "release": "pnpm run build && pnpm --filter @intentset/core --filter @intentset/markset-adapter --filter @intentset/architecture --filter @intentset/verification --filter @intentset/publisher --filter @intentset/help --filter @intentset/atlas --filter @intentset/mcp --filter @intentset/conformance-suite --filter @intentset/cli publish",
    "smoke:packed": "pnpm run build && node --conditions=intentset-source test/consumer/smoke.ts --packed",
    "smoke:registry": "node --conditions=intentset-source test/consumer/smoke.ts --registry"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@intentset/architecture": "workspace:*",
    "@intentset/atlas": "workspace:*",
    "@intentset/cli": "workspace:*",
    "@intentset/conformance": "workspace:*",
    "@intentset/conformance-suite": "workspace:*",
    "@intentset/core": "workspace:*",
    "@intentset/help": "workspace:*",
    "@intentset/markset-adapter": "workspace:*",
    "@intentset/mcp": "workspace:*",
    "@intentset/publisher": "workspace:*",
    "@intentset/verification": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intentset/intentset.git"
  },
  "homepage": "https://intentset.org/",
  "packageManager": "pnpm@11.24.0"
}
