{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intentset v0.3 authoring frontmatter",
  "description": "Structural schema; semantic graph, narrative, path, lifecycle and evidence checks are additional requirements.",
  "type": "object",
  "required": ["markset", "intentset"],
  "properties": {
    "markset": {
      "const": 0
    },
    "intentset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "profile", "id", "type", "title", "status", "owner", "visibility", "audiences"],
      "properties": {
        "spec": {
          "const": "0.3"
        },
        "profile": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "type": {
          "enum": [
            "product",
            "intent",
            "outcome",
            "measure",
            "capability",
            "behavior",
            "rule",
            "scenario",
            "slice",
            "contract",
            "verification",
            "knowledge",
            "decision"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["draft", "approved", "deprecated", "retired"]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": ["public", "customer", "internal", "restricted"]
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "governedBy": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "illustrates": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "implements": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "exposes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "consumes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "verifies": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "explains": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "informedBy": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "supports": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            },
            "replacedBy": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            }
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["products", "releases", "roles", "editions", "flags"],
          "properties": {
            "products": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "releases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "editions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "reviewedAt": {
          "type": "string"
        },
        "reviewedBy": {
          "type": "string"
        },
        "delivery": {
          "enum": ["planned", "built"],
          "description": "Core \u00a77, ADR 0017: whether the work the record describes exists, apart from its approval. Capability, behavior, rule, scenario, slice and contract only; absent means not stated."
        },
        "approval": {
          "type": "object",
          "description": "Core \u00a77, ADR 0020: how the record came to be approved. Any type; optional, also on an approved record. Shape only: who may approve is never checked.",
          "additionalProperties": false,
          "required": ["at", "basis"],
          "properties": {
            "by": { "type": "string", "minLength": 1 },
            "at": { "type": "string", "minLength": 1 },
            "basis": { "enum": ["direct", "derived", "attested"] },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref"],
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "revision": { "type": "string", "minLength": 1 },
                "digest": { "type": "string", "minLength": 1 }
              },
              "anyOf": [{ "required": ["revision"] }, { "required": ["digest"] }]
            },
            "attestedBy": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "basis": { "const": "direct" } } },
              "then": {
                "required": ["by"],
                "not": { "anyOf": [{ "required": ["source"] }, { "required": ["attestedBy"] }] }
              }
            },
            { "if": { "properties": { "basis": { "const": "derived" } } }, "then": { "required": ["by", "source"] } },
            {
              "if": { "properties": { "basis": { "const": "attested" } } },
              "then": {
                "required": ["attestedBy"],
                "not": { "anyOf": [{ "required": ["by"] }, { "required": ["source"] }] }
              }
            }
          ]
        },
        "formalizes": {
          "type": "array",
          "description": "Core \u00a75, ADR 0020: the requirements outside the model that a behavior, rule or scenario formalizes. Never resolved.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "anchor": { "type": "string", "minLength": 1 }
            }
          }
        },
        "extensions": {
          "type": "object",
          "description": "Namespaced keys, preserved and never interpreted. intentset.org/review is no longer read: a knowledge record's review is review (ADR 0025).",
          "propertyNames": {
            "pattern": "^[^/]+/.+$",
            "not": {
              "const": "intentset.org/review"
            }
          }
        },
        "review": {
          "type": "object",
          "description": "Knowledge only (Core \u00a79, publication \u00a73, ADR 0025): the hash each source had at review, by source ID. hash absent means content-v1; file-v1 is the whole file; any other value matches no pin. snapshot is informative. self and gates pin the knowledge's own text and who could see each source (ADR 0027).",
          "additionalProperties": false,
          "required": ["sources"],
          "properties": {
            "sources": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "hash": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "snapshot": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "self": {
              "type": "string",
              "minLength": 1,
              "description": "The knowledge's own content hash when it was reviewed: its content-v1 hash without ending, whatever hash says (publication \u00a73, ADR 0027)."
            },
            "gates": {
              "type": "string",
              "minLength": 1,
              "description": "The gate hash of the review's sources when it was reviewed: each source's audiences, visibility and availability (publication \u00a73, ADR 0027)."
            }
          }
        },
        "slice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "domain", "entrypoints", "layers", "claims", "usesResources"],
          "properties": {
            "kind": {
              "enum": ["product", "technical"]
            },
            "rationale": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "entrypoints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "layers": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "path"],
                "properties": {
                  "kind": {
                    "enum": ["source", "backend", "contract", "verification", "documentation"]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "usesResources": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "uniqueItems": true
            }
          }
        },
        "tips": {
          "type": "object",
          "description": "Knowledge only (Core \u00a79): one sentence of plain text per explained ID, for a product to show beside the control that delivers it. Each key must be in links.explains, which the validator checks (CORE003).",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "locator", "selector"],
          "properties": {
            "method": {
              "enum": ["automated", "manual"]
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "exercises": {
              "type": "array",
              "description": "Optional (Core \u00a78): slice or registry resource IDs the check drives beyond what the slices implementing its behaviors reach. A change to their files makes the check's evidence stale under subject binding. The validator checks that each names a slice or a resource (CORE003).",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              }
            }
          }
        },
        "measure": {
          "type": "object",
          "description": "Measure only (Core \u00a76): how the parent outcome is judged. baseline is a value or the literal unknown; source names an entry in the repository's evidenceSources registry, which the validator checks (CORE005).",
          "additionalProperties": false,
          "required": ["metric", "baseline", "target", "window", "source"],
          "properties": {
            "metric": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
            },
            "baseline": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "window": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "enum": ["increase", "decrease"]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "product"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/product/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "intent"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/intent/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "outcome"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/outcome/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "measure"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/measure/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "capability"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/capability/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "behavior"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/behavior/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rule"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/rule/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scenario"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/scenario/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slice"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/slice/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "contract"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/contract/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "verification"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/verification/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "knowledge"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/knowledge/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "decision"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/decision/0.3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "behavior"
              }
            }
          },
          "then": {
            "required": ["availability"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "knowledge"
              }
            }
          },
          "then": {
            "required": ["availability"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slice"
              }
            }
          },
          "then": {
            "required": ["slice"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "verification"
              }
            }
          },
          "then": {
            "required": ["verification"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "measure"
              }
            }
          },
          "then": {
            "required": ["measure", "parent"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "intent"
              }
            }
          },
          "then": {
            "required": ["parent"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "outcome"
              }
            }
          },
          "then": {
            "required": ["parent"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "capability"
              }
            }
          },
          "then": {
            "required": ["parent"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "behavior"
              }
            }
          },
          "then": {
            "required": ["parent"]
          }
        },
        {
          "if": {
            "required": ["delivery"]
          },
          "then": {
            "properties": {
              "type": {
                "enum": ["capability", "behavior", "rule", "scenario", "slice", "contract"]
              }
            }
          }
        },
        {
          "if": { "required": ["formalizes"] },
          "then": { "properties": { "type": { "enum": ["behavior", "rule", "scenario"] } } }
        },
        {
          "if": {
            "required": ["review"]
          },
          "then": {
            "properties": {
              "type": {
                "const": "knowledge"
              }
            }
          }
        },
        {
          "if": {
            "required": ["tips"]
          },
          "then": {
            "properties": {
              "type": {
                "const": "knowledge"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
