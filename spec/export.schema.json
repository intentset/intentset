{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentset.org/spec/export.schema.json",
  "title": "Intentset export envelope, intentset/export/0.1",
  "description": "The normalized JSON graph of Core §12 and the minimum graph exchange of the integration contract. Artifacts are sorted by id and every list inside the envelope is sorted, so the same validation with the same generatedAt is the same bytes. Optional report sections are absent when not supplied, which means not supplied, never zero or pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "spec",
    "generatedAt",
    "repository",
    "products",
    "source",
    "graphHash",
    "release",
    "validation",
    "registries",
    "artifacts"
  ],
  "properties": {
    "contract": {
      "const": "intentset/export/0.1",
      "description": "A consumer rejects any other value."
    },
    "spec": {
      "const": "0.1"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "ISO 8601 generation time; outside the graph hash."
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "description": "Stable repository identity from .intentset/config.yaml."
    },
    "products": {
      "description": "IDs of the product artifacts in the graph, sorted.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "description": "Full commit ID, or null when none could be read."
        },
        "commitUnavailable": {
          "type": "string",
          "minLength": 1,
          "description": "Why commit is null. Present exactly when commit is null."
        }
      },
      "if": {
        "properties": {
          "commit": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": ["commitUnavailable"]
      },
      "else": {
        "not": {
          "required": ["commitUnavailable"]
        }
      }
    },
    "graphHash": {
      "$ref": "#/$defs/sha256",
      "description": "ADR 0005: SHA-256 over the canonical list of id, type, sourceHash and authored links."
    },
    "release": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "label"],
          "properties": {
            "product": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "Opaque, matched exactly (Core §7)."
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "scope", "status", "errors", "warnings", "diagnostics"],
      "properties": {
        "level": {
          "enum": ["L1", "L2", "L3", "L4", "L5"]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": ["pass", "fail"],
          "description": "fail exactly when errors is above zero."
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "description": "Sorted by path, artifact, code, line, column, field, message (ADR 0004)."
        }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owners", "audiences", "releases", "roles", "editions", "flags", "resources"],
      "properties": {
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "owner", "consumers"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "consumers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "description": "Sorted by id."
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional sections. An absent section means not supplied.",
      "properties": {
        "evidence": {},
        "knowledge": {},
        "impact": {}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "origin", "artifact", "path", "message", "remediation"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]+[0-9]{3}$"
        },
        "severity": {
          "enum": ["error", "warning"]
        },
        "origin": {
          "enum": ["syntax", "profile", "graph", "architecture", "evidence", "publication", "render"]
        },
        "artifact": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line"],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "field": {
          "type": "string",
          "pattern": "^(?:/.*)?$",
          "description": "JSON pointer into the frontmatter."
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products", "releases", "roles", "editions", "flags"],
      "properties": {
        "products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "domain", "entrypoint", "layers", "claims", "usesResources"],
      "properties": {
        "kind": {
          "enum": ["product", "technical"]
        },
        "rationale": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "layers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": {
                "enum": ["source", "backend", "contract", "verification", "documentation"]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "usesResources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "locator", "selector"],
      "properties": {
        "method": {
          "enum": ["automated", "manual"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "status",
        "owner",
        "visibility",
        "audiences",
        "profile",
        "revision",
        "path",
        "sourceHash",
        "parent",
        "links",
        "derived",
        "availability",
        "slice",
        "verification",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "product",
            "intent",
            "outcome",
            "capability",
            "behavior",
            "rule",
            "scenario",
            "slice",
            "contract",
            "verification",
            "knowledge",
            "decision"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["draft", "approved", "implemented", "released", "deprecated", "retired"]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": ["public", "customer", "internal", "restricted"]
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "profile": {
          "type": "string",
          "pattern": "^intentset/[a-z]+/0\\.1$"
        },
        "revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative POSIX path of the source document."
        },
        "sourceHash": {
          "$ref": "#/$defs/sha256"
        },
        "parent": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "description": "Authored edges by kind, targets sorted.",
          "properties": {
            "governedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "illustrates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "implements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "exposes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "consumes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "verifies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "explains": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "informedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "requires": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "supports": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "replacedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          }
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "description": "Inverse edges by the authored kind: derived.governedBy on a rule lists the behaviors that name it. Derived, never authored (Core §5, §12).",
          "properties": {
            "parent": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "governedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "illustrates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "implements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "exposes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "consumes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "verifies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "explains": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "informedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "requires": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "supports": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "replacedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          }
        },
        "availability": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/availability"
            }
          ]
        },
        "slice": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/slice"
            }
          ]
        },
        "verification": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/verification"
            }
          ]
        },
        "extensions": {
          "type": ["object", "null"],
          "propertyNames": {
            "pattern": "^[^/]+/.+$"
          }
        },
        "body": {
          "type": "string",
          "description": "Present only when the export was asked to include bodies."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "product"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/product/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "intent"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/intent/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "outcome"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/outcome/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "capability"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/capability/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "behavior"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/behavior/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rule"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/rule/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scenario"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/scenario/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slice"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/slice/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "contract"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/contract/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "verification"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/verification/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "knowledge"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/knowledge/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "decision"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/decision/0.1"
              }
            }
          }
        }
      ]
    }
  }
}
