{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentset.org/spec/export.schema.json",
  "title": "Intentset export envelope, intentset/export/0.2",
  "description": "The export contract of spec/export.md: the normalized JSON graph of Core §12 and the minimum graph exchange of the integration contract. Artifacts are sorted by id and every list inside the envelope is sorted, so the same validation with the same generatedAt is the same bytes. Restricted artifacts are withheld unless asked for, and every omission is counted. Optional report sections are absent when not supplied, which means not supplied, never zero or pass. Some requirements are beyond a schema and are checked by a consumer's reader (spec/export.md §5): identity, snapshot agreement between the reports and the envelope, withholding, and consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "spec",
    "generatedAt",
    "repository",
    "products",
    "source",
    "graphHash",
    "release",
    "validation",
    "withholding",
    "registries",
    "artifacts",
    "reports"
  ],
  "properties": {
    "contract": {
      "const": "intentset/export/0.2",
      "description": "A consumer rejects any other value (spec/export.md §5)."
    },
    "spec": {
      "const": "0.1"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "ISO 8601 generation time; outside the graph hash."
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "description": "Stable repository identity from .intentset/config.yaml."
    },
    "products": {
      "description": "IDs of the product artifacts in the graph, sorted.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "uncommitted"],
      "properties": {
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "description": "Full commit ID, or null when none could be read."
        },
        "commitUnavailable": {
          "type": "string",
          "minLength": 1,
          "description": "Why commit is null. Present exactly when commit is null."
        },
        "uncommitted": {
          "type": "boolean",
          "description": "True when tracked files differed from the commit, so the commit alone does not describe what was read. False when commit is null."
        }
      },
      "if": {
        "properties": {
          "commit": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": ["commitUnavailable"],
        "properties": {
          "uncommitted": {
            "const": false
          }
        }
      },
      "else": {
        "not": {
          "required": ["commitUnavailable"]
        }
      }
    },
    "graphHash": {
      "$ref": "#/$defs/sha256",
      "description": "ADR 0005: SHA-256 over the canonical list of id, type, sourceHash and authored links, withheld artifacts included: it names the snapshot, which evidence is bound to."
    },
    "release": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "label"],
          "properties": {
            "product": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "Opaque, matched exactly (Core §7)."
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "scope", "status", "errors", "warnings", "diagnostics"],
      "properties": {
        "level": {
          "enum": ["L1", "L2", "L3", "L4", "L5"]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": ["pass", "fail"],
          "description": "fail exactly when errors is above zero."
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "description": "Over the whole validation, withheld artifacts included."
        },
        "warnings": {
          "type": "integer",
          "minimum": 0,
          "description": "Over the whole validation, withheld artifacts included."
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "description": "Sorted by path, artifact, code, line, column, field, message (ADR 0004). Diagnostics about a withheld artifact are left out and counted in withholding.diagnostics; any other that names one has the ID redacted."
        }
      }
    },
    "withholding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibilities", "artifacts", "diagnostics"],
      "description": "What the export leaves out, so a short export never reads as a complete one.",
      "properties": {
        "visibilities": {
          "type": "array",
          "items": {
            "enum": ["public", "customer", "internal", "restricted"]
          },
          "uniqueItems": true,
          "description": "The visibilities withheld: [\"restricted\"] by default, [] when restricted artifacts were asked for."
        },
        "artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owners", "audiences", "releases", "roles", "editions", "flags", "resources"],
      "properties": {
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "owner", "consumers"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "consumers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "Withheld slices are left out."
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "description": "Sorted by id."
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional sections (spec/export.md §4). An absent section means not supplied, never zero, none or pass.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidenceReport"
        },
        "knowledge": {
          "$ref": "#/$defs/knowledgeReport"
        },
        "impact": {
          "$ref": "#/$defs/impactReport"
        },
        "ownership": {
          "$ref": "#/$defs/ownershipReport"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "origin", "artifact", "path", "message", "remediation"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]+[0-9]{3}$"
        },
        "severity": {
          "enum": ["error", "warning"]
        },
        "origin": {
          "enum": ["syntax", "profile", "graph", "architecture", "evidence", "publication", "render"]
        },
        "artifact": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line"],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "field": {
          "type": "string",
          "pattern": "^(?:/.*)?$",
          "description": "JSON pointer into the frontmatter."
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products", "releases", "roles", "editions", "flags"],
      "properties": {
        "products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "domain", "entrypoints", "layers", "claims", "usesResources"],
      "properties": {
        "kind": {
          "enum": ["product", "technical"]
        },
        "rationale": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "layers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": {
                "enum": ["source", "backend", "contract", "verification", "documentation"]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "usesResources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "locator", "selector"],
      "properties": {
        "method": {
          "enum": ["automated", "manual"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "status",
        "owner",
        "visibility",
        "audiences",
        "profile",
        "revision",
        "path",
        "sourceHash",
        "parent",
        "links",
        "derived",
        "withheldLinks",
        "availability",
        "slice",
        "verification",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "product",
            "intent",
            "outcome",
            "capability",
            "behavior",
            "rule",
            "scenario",
            "slice",
            "contract",
            "verification",
            "knowledge",
            "decision"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["draft", "approved", "implemented", "released", "deprecated", "retired"]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": ["public", "customer", "internal", "restricted"]
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "profile": {
          "type": "string",
          "pattern": "^intentset/[a-z]+/0\\.1$"
        },
        "revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative POSIX path of the source document."
        },
        "sourceHash": {
          "$ref": "#/$defs/sha256"
        },
        "parent": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ],
          "description": "Null when there is none, or when the parent is withheld."
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "description": "Authored edges by kind, targets sorted.",
          "properties": {
            "governedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "illustrates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "implements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "exposes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "consumes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "verifies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "explains": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "informedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "requires": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "supports": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "replacedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          }
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "description": "Inverse edges by the authored kind: derived.governedBy on a rule lists the behaviors that name it. Derived, never authored (Core §5, §12).",
          "properties": {
            "parent": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "governedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "illustrates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "implements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "exposes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "consumes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "verifies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "explains": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "informedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "requires": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "supports": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "replacedBy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          }
        },
        "withheldLinks": {
          "type": "integer",
          "minimum": 0,
          "description": "Link targets and sources left out because the artifact at the other end is withheld: authored, derived and parent."
        },
        "availability": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/availability"
            }
          ]
        },
        "slice": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/slice"
            }
          ]
        },
        "verification": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/verification"
            }
          ]
        },
        "extensions": {
          "type": ["object", "null"],
          "propertyNames": {
            "pattern": "^[^/]+/.+$"
          }
        },
        "body": {
          "type": "string",
          "description": "Present only when the export was asked to include bodies."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "product"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/product/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "intent"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/intent/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "outcome"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/outcome/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "capability"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/capability/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "behavior"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/behavior/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rule"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/rule/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scenario"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/scenario/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slice"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/slice/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "contract"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/contract/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "verification"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/verification/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "knowledge"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/knowledge/0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "decision"
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "const": "intentset/decision/0.1"
              }
            }
          }
        }
      ]
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "token": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "timestamp": {
      "type": "string",
      "description": "UTC, ISO 8601, with a Z suffix and an optional fraction of up to nine digits.",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "runRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "verificationId",
        "commit",
        "graphHash",
        "environment",
        "scope",
        "tool",
        "reviewer",
        "startedAt",
        "finishedAt",
        "result",
        "uri"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/token",
          "description": "Unique per run."
        },
        "verificationId": {
          "$ref": "#/$defs/id",
          "description": "The verification artifact this run executed."
        },
        "commit": {
          "$ref": "#/$defs/token",
          "description": "The source commit the run executed against."
        },
        "graphHash": {
          "description": "SHA-256 over the canonical graph (ADR 0005), lowercase hex.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "const": "@current"
            }
          ]
        },
        "environment": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "type": "object",
          "description": "The exact product and release the run assessed; release labels match exactly (Core §7).",
          "additionalProperties": false,
          "required": ["product", "release"],
          "properties": {
            "product": {
              "$ref": "#/$defs/id"
            },
            "release": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "tool": {
          "description": "The tool and version that ran an automated check, or null for a review performed by a person alone.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version"],
              "properties": {
                "name": {
                  "$ref": "#/$defs/text"
                },
                "version": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          ]
        },
        "reviewer": {
          "description": "The reviewer's identity for a manual review, or null for an automated run.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "result": {
          "enum": ["pass", "fail", "skip", "error"]
        },
        "uri": {
          "type": "string",
          "description": "Where the run's report lives. Presence is not proof of trustworthy execution (Core §8).",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "rationale": {
          "$ref": "#/$defs/text",
          "description": "Required when reviewer is set."
        },
        "extensions": {
          "type": "object",
          "description": "Namespaced keys, preserved and never interpreted.",
          "propertyNames": {
            "pattern": "^[^/]+/.+$"
          }
        }
      },
      "allOf": [
        {
          "description": "A manual record identifies its reviewer and the review rationale.",
          "if": {
            "required": ["reviewer"],
            "properties": {
              "reviewer": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": ["rationale"]
          }
        },
        {
          "description": "A record without a reviewer is automated and names its tool.",
          "if": {
            "required": ["reviewer"],
            "properties": {
              "reviewer": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "tool": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "snapshotCommit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "description": "The envelope's source.commit."
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "lifecycle": {
      "enum": ["draft", "approved", "implemented", "released", "deprecated", "retired"]
    },
    "evidenceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "graphHash", "scope", "records", "verifications", "claims"],
      "description": "Every verification classified at the envelope's snapshot, and every claim's coverage (spec/export.md §4.1).",
      "properties": {
        "commit": {
          "$ref": "#/$defs/snapshotCommit"
        },
        "graphHash": {
          "$ref": "#/$defs/sha256",
          "description": "The envelope's graphHash."
        },
        "scope": {
          "description": "The exact product and release assessed, or null when records of every scope were considered.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["product", "release"],
              "properties": {
                "product": {
                  "$ref": "#/$defs/id"
                },
                "release": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          ]
        },
        "records": {
          "$ref": "#/$defs/count",
          "description": "Run records read, before classification."
        },
        "verifications": {
          "type": "array",
          "description": "One per exported verification, sorted by id.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "method", "status", "note", "latest", "atSnapshot", "runs", "outOfScope"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "method": {
                "enum": ["automated", "manual"]
              },
              "status": {
                "enum": ["current-pass", "current-fail", "stale", "skip", "error", "missing", "unresolved"],
                "description": "Only current-pass is a pass (Core §8)."
              },
              "note": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "latest": {
                "description": "The record that decided the status, or null when there is none.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/runRecord"
                  }
                ]
              },
              "atSnapshot": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pass", "fail", "skip", "error"],
                "properties": {
                  "pass": {
                    "$ref": "#/$defs/count"
                  },
                  "fail": {
                    "$ref": "#/$defs/count"
                  },
                  "skip": {
                    "$ref": "#/$defs/count"
                  },
                  "error": {
                    "$ref": "#/$defs/count"
                  }
                }
              },
              "runs": {
                "$ref": "#/$defs/count"
              },
              "outOfScope": {
                "$ref": "#/$defs/count"
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "description": "One per exported behavior, rule and scenario that is not retired, sorted by id.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "lifecycle", "required", "linked", "verified", "verifications", "withheld"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "enum": ["behavior", "rule", "scenario"]
              },
              "lifecycle": {
                "$ref": "#/$defs/lifecycle"
              },
              "required": {
                "type": "boolean"
              },
              "linked": {
                "type": "boolean"
              },
              "verified": {
                "type": "boolean"
              },
              "verifications": {
                "$ref": "#/$defs/ids"
              },
              "withheld": {
                "$ref": "#/$defs/count"
              }
            }
          }
        }
      }
    },
    "knowledgeReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphHash", "artifacts"],
      "description": "The review status of every exported knowledge artifact (spec/export.md §4.2, Core §9).",
      "properties": {
        "graphHash": {
          "$ref": "#/$defs/sha256",
          "description": "The envelope's graphHash."
        },
        "artifacts": {
          "type": "array",
          "description": "Sorted by id.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "lifecycle",
              "status",
              "reviewer",
              "reviewedAt",
              "sources",
              "changed",
              "missing",
              "withheld"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "lifecycle": {
                "$ref": "#/$defs/lifecycle"
              },
              "status": {
                "enum": ["current", "needs-review"]
              },
              "reviewer": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "reviewedAt": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "sources": {
                "$ref": "#/$defs/ids"
              },
              "changed": {
                "$ref": "#/$defs/ids"
              },
              "missing": {
                "$ref": "#/$defs/ids"
              },
              "withheld": {
                "$ref": "#/$defs/count"
              }
            }
          }
        }
      }
    },
    "impactHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "description": "From the start to the hit, one step per edge, each with its reason.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "via", "reason"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "via": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "impactReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphHash", "note", "starts"],
      "description": "Core §10 impact from every exported artifact (spec/export.md §4.3). A start absent here was not computed.",
      "properties": {
        "graphHash": {
          "$ref": "#/$defs/sha256",
          "description": "The envelope's graphHash."
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "starts": {
          "type": "array",
          "description": "Sorted by start.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "direct", "candidates", "context", "ancestors", "withheld"],
            "properties": {
              "start": {
                "$ref": "#/$defs/id"
              },
              "direct": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/impactHit"
                }
              },
              "candidates": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/impactHit"
                }
              },
              "context": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/impactHit"
                }
              },
              "ancestors": {
                "$ref": "#/$defs/ids"
              },
              "withheld": {
                "$ref": "#/$defs/count"
              }
            }
          }
        }
      }
    },
    "ownershipReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "graphHash", "files", "withheld"],
      "description": "Where every file the architecture check attributed falls, at the envelope's snapshot (spec/export.md §4.4; VSA §1, §3, §5).",
      "properties": {
        "commit": {
          "$ref": "#/$defs/snapshotCommit"
        },
        "graphHash": {
          "$ref": "#/$defs/sha256",
          "description": "The envelope's graphHash."
        },
        "files": {
          "type": "array",
          "description": "Sorted by path.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "region", "owner"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "enum": ["slice", "composition", "shared", "infrastructure", "resource", "backend", "unowned", "test"]
              },
              "owner": {
                "description": "The slice for slice and test, the resource for resource, otherwise null.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/id"
                  }
                ]
              }
            }
          }
        },
        "withheld": {
          "$ref": "#/$defs/count",
          "description": "Files left out because the slice that owns them is withheld."
        }
      }
    }
  }
}
